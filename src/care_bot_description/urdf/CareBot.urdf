                        <samples>9</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.7853982</min_angle>
                        <max_angle>0.7853982</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.03</min>
                    <max>2.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </ray>
            <plugin name="rear_center_tof" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=tof_cloud/rear_center</remapping>
                </ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>rear_center_tof</frame_name>
            </plugin>
        </sensor>
    </gazebo>
    <gazebo reference="rear_right_tof">
        <sensor name="rear_right_tof" type="ray">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>20</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>9</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.1745329</min_angle>
                        <max_angle>0.1745329</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>9</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.7853982</min_angle>
                        <max_angle>0.7853982</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.03</min>
                    <max>2.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </ray>
            <plugin name="rear_right_tof" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=tof_cloud/rear_right</remapping>
                </ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>rear_right_tof</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- Keep caster friction low so they slide freely without letting the base coast forever -->
    <gazebo reference="back_left_omniwheel_caster-v2">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>
    <gazebo reference="back_right_omniwheel_caster-v1">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>
    <gazebo reference="front_left_omniwheel_caster-v1">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>
    <gazebo reference="front_right_omniwheel_caster-v2">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>

    <!-- Friction for drive wheels to ensure traction -->
    <gazebo reference="left_drive_wheel-v1">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>
    <gazebo reference="right_drive_wheel-v1">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>
</robot>
