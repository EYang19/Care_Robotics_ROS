            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <mass value="0.25" />
            <inertia ixx="0.0001110673580171917" iyy="0.00011140882573268396" izz="0.00015713170459548186" ixy="1.7700679875650254e-08" iyz="1.727885135791897e-07" ixz="1.3060634582217137e-07" />
