    <joint name="base_link-v1_Revolute-14" type="continuous">
        <origin xyz="0.22914081 0.00953935 0.060036759999999995" rpy="-3.141592653589793 -1.5707963267948966 0" />
        <parent link="base_link-v1" />
        <child link="right_drive_wheel-v1" />
        <axis xyz="0.0 0.0 -1.0" />
    </joint>
    <joint name="base_link-v1_Revolute-15" type="continuous">
        <origin xyz="-0.22885919000000002 0.00953935 0.060036759999999995" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="base_link-v1" />
        <child link="left_drive_wheel-v1" />
        <axis xyz="0.0 0.0 1.0" />
    </joint>
    <joint name="base_link-v1_Revolute-16" type="fixed">
        <origin xyz="0.25550275 -0.43467188 0.025" rpy="-3.141592653589793 -1.5707963267948966 0" />
        <parent link="base_link-v1" />
        <child link="back_right_omniwheel_caster-v1" />
    </joint>
    <joint name="base_link-v1_Revolute-17" type="fixed">
        <origin xyz="0.25650275 0.43532812 0.025" rpy="-3.141592653589793 -1.5707963267948966 0" />
        <parent link="base_link-v1" />
        <child link="front_right_omniwheel_caster-v2" />
    </joint>
    <joint name="base_link-v1_Revolute-18" type="fixed">
        <origin xyz="-0.24875245 0.43532812 0.025" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="base_link-v1" />
        <child link="front_left_omniwheel_caster-v1" />
    </joint>
    <joint name="base_link-v1_Revolute-19" type="fixed">
        <origin xyz="-0.24875245 -0.43467188 0.025" rpy="-0.0 -1.5707963267948966 0" />
        <parent link="base_link-v1" />
        <child link="back_left_omniwheel_caster-v2" />
    </joint>
    <joint name="base_link_to_lidar" type="fixed">
        <origin xyz="0.0 0.0 1.15" rpy="0.0 0.0 0.0" />
        <parent link="base_link-v1" />
        <child link="lidar_scan-v1" />
    </joint>

    <!-- Gazebo joint state publisher (publishes joint states with sim time) -->
    <gazebo>
        <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
            <ros>
                <remapping>~/out:=joint_states</remapping>
            </ros>
            <update_rate>30</update_rate>
            <joint_name>base_link-v1_Revolute-14</joint_name>
            <joint_name>base_link-v1_Revolute-15</joint_name>
        </plugin>
    </gazebo>

    <!-- Gazebo differential drive plugin -->
    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>/</namespace>
            </ros>
            <update_rate>30</update_rate>
            <left_joint>base_link-v1_Revolute-15</left_joint>
            <right_joint>base_link-v1_Revolute-14</right_joint>
            <wheel_separation>0.458</wheel_separation>
            <wheel_diameter>0.12</wheel_diameter>
            <max_wheel_torque>35</max_wheel_torque>
            <max_wheel_acceleration>8.0</max_wheel_acceleration>
            <cmd_vel_timeout>0.5</cmd_vel_timeout>
            <command_topic>cmd_vel</command_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
    </gazebo>

    <!-- Gazebo lidar sensor plugin -->
    <gazebo reference="lidar_scan-v1">
        <sensor name="lidar" type="ray">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>500</samples>
                        <resolution>1.000000</resolution>
                        <min_angle>0.000000</min_angle>
                        <max_angle>6.283185</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>12.0</max>
                    <resolution>0.015</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_scan-v1</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="front_left_tof">
        <sensor name="front_left_tof" type="ray">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>20</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>9</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.1745329</min_angle>
                        <max_angle>0.1745329</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>9</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.7853982</min_angle>
                        <max_angle>0.7853982</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.03</min>
                    <max>2.0</max>
